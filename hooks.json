{
  "overclock": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/antigravity.py",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/antigravity.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/antigravity.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
